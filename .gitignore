# ============================================================
# CDD World Encyclopedia — .gitignore
# ============================================================

# ---- Dependencies ----
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ---- Testing / coverage ----
/coverage

# ---- Next.js build outputs (do NOT commit; regenerate via next build / next dev) ----
/.next/
/out/
/build/

# ---- TypeScript / Next.js auto-generated ----
*.tsbuildinfo
next-env.d.ts

# ---- Platform-specific caches ----
.DS_Store
Thumbs.db

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
build.log

# ---- Environment / secrets (never commit) ----
.env
.env*.local
.env.*.local

# ---- Deployment platforms (local config only) ----
.vercel
.netlify
.firebase/

# ---- Certificates & keys ----
*.pem
*.key
*.crt
*.pfx
*.p12
id_rsa
id_rsa.enc

# ---- Local convenience scripts (machine-specific) ----
_build.cmd
*.ps1
!scripts/*.ps1
!scripts/*.mjs

# ---- Release archives (generated from out/ via tar.exe) ----
*.zip
*.tar.gz
*.tar

# ---- Temporary extraction / test directories ----
_test_extract/
_tmp/
